{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/type_adapter.schema.json",
  "title": "TypeAdapter",
  "description": "A reviewed, deterministic connector primitive that reshapes one port type into a compatible one (FromPort -> ToPort), so the route compiler can bridge a near-match instead of emitting a gap. Registered as a capability-graph node with kind type_adapter; an adapter-mediated route discloses the bridge as an explicit step. Every adapter names a backing implementation whose proofs must pass. Generated by scripts/build_type_adapters_pack.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "adapter_id",
    "title",
    "from_port",
    "to_port",
    "input_edge",
    "output_edge",
    "transform_kind",
    "lossiness",
    "blackbox",
    "effects",
    "proof_requirements",
    "implementation_ref",
    "reviewed",
    "version",
    "candidate",
    "serves_truth"
  ],
  "properties": {
    "record_type": { "const": "type_adapter" },
    "adapter_id": { "type": "string", "pattern": "^adapt:[a-z0-9_]+$" },
    "title": { "type": "string", "minLength": 3 },
    "from_port": { "type": "string", "pattern": "^[A-Za-z0-9]+$" },
    "to_port": { "type": "string", "pattern": "^[A-Za-z0-9]+$" },
    "input_edge": { "type": "string", "pattern": "^[A-Za-z0-9+]+$" },
    "output_edge": { "type": "string", "pattern": "^[A-Za-z0-9+]+$" },
    "transform_kind": {
      "enum": ["rename_envelope", "wrap_singleton", "unwrap_singleton",
               "project_subset", "reshape_structural", "coordinate_reproject",
               "format_reencode"]
    },
    "lossiness": { "enum": ["lossless", "lossy"] },
    "blackbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["does"],
      "properties": { "does": { "type": "string", "minLength": 20 } }
    },
    "effects": {
      "type": "array",
      "items": { "enum": ["none"] },
      "minItems": 1
    },
    "proof_requirements": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "implementation_ref": { "type": "string", "pattern": "^primitives\\.[a-z_]+:[a-z0-9_]+$" },
    "reviewed": { "const": true },
    "fields_dropped_note": { "type": "string" },
    "version": { "type": "string" },
    "candidate": { "const": true },
    "serves_truth": { "const": false }
  }
}
