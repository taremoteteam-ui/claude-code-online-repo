{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/capability_graph_node.schema.json",
  "title": "CapabilityGraphNode",
  "description": "One primitive as a typed node in the capability graph: its edges parsed into typed ports (data inputs it needs upstream, config ports supplied by the request, output ports it produces). The route compiler traverses these nodes to assemble a chain by port-type compatibility - without reading any primitive's internals. Generated by scripts/build_capability_graph.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "node_id",
    "lane",
    "kind",
    "title",
    "input_edge",
    "output_edge",
    "required_input_ports",
    "config_ports",
    "output_ports",
    "effects",
    "version",
    "candidate",
    "serves_truth"
  ],
  "properties": {
    "record_type": { "const": "capability_graph_node" },
    "node_id": { "type": "string", "pattern": "^(prim|resolved|grp):[a-z0-9_.]+$" },
    "lane": { "type": "string" },
    "kind": { "type": "string" },
    "title": { "type": "string" },
    "input_edge": { "type": "string" },
    "output_edge": { "type": "string" },
    "required_input_ports": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "canonical_type"],
        "properties": {
          "name": { "type": "string" },
          "canonical_type": { "type": "string" }
        }
      }
    },
    "config_ports": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "canonical_type"],
        "properties": {
          "name": { "type": "string" },
          "canonical_type": { "type": "string" }
        }
      }
    },
    "output_ports": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "role", "canonical_type"],
        "properties": {
          "name": { "type": "string" },
          "role": { "enum": ["data", "config", "receipt"] },
          "canonical_type": { "type": "string" }
        }
      }
    },
    "effects": { "type": "array", "items": { "type": "string" } },
    "version": { "type": "string" },
    "candidate": { "const": true },
    "serves_truth": { "const": false }
  }
}
