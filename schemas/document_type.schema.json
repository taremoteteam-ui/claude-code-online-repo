{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/document_type.schema.json",
  "title": "DocumentType",
  "description": "A document/contract type family for the document-extraction lane. Declares which field families apply, so the builder crosses only meaningful (doc_type x field) pairs instead of a blind cartesian. Generated by scripts/build_document_extraction_pack.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "doc_type_id",
    "title",
    "industry",
    "description",
    "typical_formats",
    "governing_law_sensitivity",
    "risk_class",
    "applicable_field_families",
    "key_clause_types",
    "source_ref_families",
    "human_review_required",
    "version",
    "candidate",
    "serves_truth"
  ],
  "properties": {
    "record_type": { "const": "document_type" },
    "doc_type_id": { "type": "string", "pattern": "^doctype:[a-z0-9_]+\\.[a-z0-9_]+$" },
    "title": { "type": "string", "minLength": 3 },
    "industry": {
      "enum": [
        "cross_industry",
        "employment_hr",
        "real_estate",
        "oil_gas_energy",
        "commercial_general",
        "financial_lending",
        "corporate_governance",
        "ip_technology",
        "healthcare",
        "government_procurement",
        "insurance",
        "litigation_disputes",
        "supply_chain_logistics",
        "construction"
      ]
    },
    "description": { "type": "string", "minLength": 20 },
    "typical_formats": {
      "type": "array",
      "items": { "enum": ["pdf_native", "pdf_scanned", "docx", "doc", "html", "image", "txt", "email"] },
      "minItems": 1
    },
    "governing_law_sensitivity": { "enum": ["low", "medium", "high"] },
    "risk_class": { "enum": ["low", "medium", "high"] },
    "applicable_field_families": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 3
    },
    "key_clause_types": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "source_ref_families": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "human_review_required": { "type": "boolean" },
    "version": { "type": "string" },
    "candidate": { "const": true },
    "serves_truth": { "const": false }
  }
}
