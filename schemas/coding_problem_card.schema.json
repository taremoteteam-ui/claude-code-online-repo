{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/coding_problem_card.schema.json",
  "title": "CodingProblemCard",
  "description": "One harvested coding problem (LeetCode / competitive / interview / hackathon STYLE - synthetic paraphrase, not copied text). primitive_uses is the decomposition of its verified solution. Generated by scripts/build_coding_primitive_pack.py from fixtures/coding-problems/problems.json - never hand-edited.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type", "problem_id", "source", "difficulty", "category",
    "statement", "primitive_uses", "test_case_count", "retrieved_mode",
    "version", "candidate", "serves_truth"
  ],
  "properties": {
    "record_type": { "const": "coding_problem_card" },
    "problem_id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "source": { "enum": ["leetcode", "codeforces", "interview", "hackathon"] },
    "difficulty": { "enum": ["easy", "medium", "hard"] },
    "category": { "type": "string", "minLength": 1 },
    "statement": { "type": "string", "minLength": 1 },
    "primitive_uses": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^algo:[a-z0-9_]+$" } },
    "test_case_count": { "type": "integer", "minimum": 1 },
    "retrieved_mode": { "const": "fixture_synthetic" },
    "version": { "type": "string" },
    "candidate": { "const": true },
    "serves_truth": { "const": false }
  }
}
