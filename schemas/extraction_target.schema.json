{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/extraction_target.schema.json",
  "title": "ExtractionTarget",
  "description": "A materialized (document_type x field) extraction-target candidate: the compact contract for extracting one field from one document type, with source-span verification as a mandatory proof. Materialized by the builder crossing each document type with the fields whose family it declares applicable - a principled lattice, never a blind cartesian.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "target_id",
    "doc_type_ref",
    "field_ref",
    "title",
    "input_edge",
    "output_edge",
    "value_type",
    "cardinality",
    "extraction_route",
    "proof_requirements",
    "risk_class",
    "human_review_required",
    "version",
    "candidate",
    "serves_truth"
  ],
  "properties": {
    "record_type": { "const": "document_extraction_target" },
    "target_id": {
      "type": "string",
      "pattern": "^target:[a-z0-9_]+\\.[a-z0-9_]+\\.[a-z0-9_]+\\.[a-z0-9_]+$"
    },
    "doc_type_ref": { "type": "string", "pattern": "^doctype:[a-z0-9_]+\\.[a-z0-9_]+$" },
    "field_ref": { "type": "string", "pattern": "^field:[a-z0-9_]+\\.[a-z0-9_]+$" },
    "title": { "type": "string", "minLength": 3 },
    "input_edge": { "type": "string", "pattern": "^[A-Za-z0-9+]+$" },
    "output_edge": { "type": "string", "pattern": "^[A-Za-z0-9+]+$" },
    "value_type": { "type": "string" },
    "cardinality": { "enum": ["one", "zero_or_one", "zero_or_many", "one_or_many"] },
    "extraction_route": {
      "enum": [
        "anchor_regex",
        "keyword_proximity",
        "section_scoped",
        "table_cell",
        "layout_region",
        "semantic_model_bounded",
        "hybrid"
      ]
    },
    "proof_requirements": { "type": "array", "items": { "type": "string" }, "minItems": 2 },
    "risk_class": { "enum": ["low", "medium", "high"] },
    "human_review_required": { "type": "boolean" },
    "version": { "type": "string" },
    "candidate": { "const": true },
    "serves_truth": { "const": false }
  }
}
