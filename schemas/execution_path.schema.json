{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/execution_path.schema.json",
  "title": "ExecutionPath",
  "description": "One interchangeable path in a DecisionPoint's portfolio: a method that satisfies the decision's contract, with a declarative applicability predicate, a cost model, a reversibility class, and (optionally) a real handler whose receipts the engine can observe. Adding a path is a data row, never a rewrite. Generated by scripts/build_decision_portfolio_pack.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "path_id",
    "decision_id",
    "title",
    "method",
    "applicability",
    "cost_model",
    "reversibility",
    "preference_rank",
    "deterministic",
    "expected_receipts",
    "version",
    "candidate",
    "serves_truth"
  ],
  "properties": {
    "record_type": { "const": "execution_path" },
    "path_id": { "type": "string", "pattern": "^path:[a-z0-9_.]+$" },
    "decision_id": { "type": "string", "pattern": "^decision:[a-z0-9_.]+$" },
    "title": { "type": "string", "minLength": 3 },
    "method": { "type": "string", "minLength": 10 },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requires_keys", "conditions"],
      "properties": {
        "requires_keys": { "type": "array", "items": { "type": "string" } },
        "conditions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "op"],
            "properties": {
              "key": { "type": "string" },
              "op": { "enum": ["eq", "ne", "gt", "gte", "lt", "lte", "in", "exists", "truthy", "falsy"] },
              "value": {}
            }
          }
        }
      }
    },
    "cost_model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tokens", "latency_ms", "side_effect_risk"],
      "properties": {
        "tokens": { "type": "number", "minimum": 0 },
        "latency_ms": { "type": "number", "minimum": 0 },
        "side_effect_risk": { "enum": ["none", "low", "medium", "high"] },
        "build_effort": { "enum": ["none", "low", "medium", "high"] }
      }
    },
    "reversibility": { "enum": ["reversible", "costly", "one_way"] },
    "preference_rank": { "type": "integer", "minimum": 0 },
    "deterministic": { "type": "boolean" },
    "handler_ref": { "type": "string", "pattern": "^primitives\\.[a-z_]+:[a-z0-9_]+$" },
    "expected_receipts": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "revival_trigger": { "type": "string" },
    "version": { "type": "string" },
    "candidate": { "const": true },
    "serves_truth": { "const": false }
  }
}
