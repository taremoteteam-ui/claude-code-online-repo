{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/extraction_field.schema.json",
  "title": "ExtractionField",
  "description": "One extractable field in the document-extraction catalog, grouped by field family. Fields are crossed with document types (by family) to materialize extraction-target candidates. Generated by scripts/build_document_extraction_pack.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "field_id",
    "family",
    "title",
    "value_type",
    "cardinality",
    "description",
    "normalization",
    "extraction_difficulty",
    "proof_requirements",
    "version",
    "candidate",
    "serves_truth"
  ],
  "properties": {
    "record_type": { "const": "extraction_field" },
    "field_id": { "type": "string", "pattern": "^field:[a-z0-9_]+\\.[a-z0-9_]+$" },
    "family": {
      "enum": [
        "parties",
        "identifiers",
        "dates",
        "monetary",
        "quantities",
        "obligations",
        "term_termination",
        "governing_law_jurisdiction",
        "signatures_execution",
        "definitions",
        "conditions",
        "representations_warranties",
        "indemnification_liability",
        "confidentiality",
        "dispute_resolution",
        "property_description",
        "real_estate_specific",
        "oil_gas_specific",
        "employment_specific",
        "ip_specific",
        "financial_specific",
        "insurance_specific"
      ]
    },
    "title": { "type": "string", "minLength": 3 },
    "value_type": {
      "enum": [
        "party_entity",
        "person_name",
        "org_name",
        "address",
        "date",
        "date_range",
        "money_amount",
        "currency",
        "percentage",
        "duration",
        "number",
        "quantity_with_unit",
        "boolean",
        "enum_category",
        "free_text_clause",
        "identifier",
        "legal_citation",
        "geo_description",
        "list"
      ]
    },
    "cardinality": { "enum": ["one", "zero_or_one", "zero_or_many", "one_or_many"] },
    "description": { "type": "string", "minLength": 15 },
    "normalization": {
      "enum": [
        "none",
        "iso_date",
        "currency_decimal",
        "percentage_fraction",
        "duration_iso8601",
        "party_canonical",
        "address_usps",
        "boolean_normalize",
        "enum_map",
        "number_parse"
      ]
    },
    "extraction_difficulty": { "enum": ["easy", "medium", "hard"] },
    "proof_requirements": {
      "type": "array",
      "items": {
        "enum": [
          "source_span_verification",
          "value_type_validation",
          "normalization_roundtrip",
          "cardinality_check",
          "enum_domain_check",
          "no_hallucinated_span",
          "human_review_flag"
        ]
      },
      "minItems": 2
    },
    "version": { "type": "string" },
    "candidate": { "const": true },
    "serves_truth": { "const": false }
  }
}
