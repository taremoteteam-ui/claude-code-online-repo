{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/negative_memory.schema.json",
  "title": "NegativeMemory",
  "description": "A remembered failure: what broke, which primitives and task families it affected, evidence that it actually happened (receipt ids, run directories, commit shas), and the suppression rule the router must apply so the same waste is not repeated. Negative memory records failures; it never promotes truth.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "memory_id",
    "failure_class",
    "description",
    "affected_primitive_ids",
    "affected_task_families",
    "evidence_refs",
    "suppression_rule",
    "resolution_status",
    "fixed_by",
    "version",
    "candidate",
    "serves_truth"
  ],
  "properties": {
    "record_type": { "const": "negative_memory" },
    "memory_id": { "type": "string", "pattern": "^negmem:[a-z0-9_.]+$" },
    "failure_class": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "description": { "type": "string", "minLength": 20 },
    "affected_primitive_ids": {
      "type": "array",
      "items": { "type": "string", "pattern": "^prim:[a-z0-9_.]+$" },
      "minItems": 1
    },
    "affected_task_families": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9_]+$" },
      "minItems": 1
    },
    "evidence_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 3 },
      "minItems": 1,
      "description": "Receipt ids, run directories, or commit:<sha> refs proving the failure was observed, not invented."
    },
    "suppression_rule": {
      "type": "string",
      "minLength": 20,
      "description": "What the router must avoid while this memory applies."
    },
    "resolution_status": { "enum": ["open", "fixed", "superseded"] },
    "fixed_by": { "type": ["string", "null"] },
    "version": { "type": "string" },
    "candidate": { "const": true },
    "serves_truth": { "const": false }
  }
}
