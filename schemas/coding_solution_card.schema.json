{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/coding_solution_card.schema.json",
  "title": "CodingSolutionCard",
  "description": "A verified solution to a coding problem, composed from algorithmic primitive kernels. verified/test_cases_passed record that the solution actually ran green against the problem's fixtures at build time; the checker re-runs to gate. Generated by scripts/build_coding_primitive_pack.py - never hand-edited.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type", "solution_id", "problem_ref", "uses",
    "verified", "test_cases_passed", "test_cases_total",
    "runtime_target", "effects", "version", "candidate", "serves_truth"
  ],
  "properties": {
    "record_type": { "const": "coding_solution_card" },
    "solution_id": { "type": "string", "pattern": "^sol:[a-z0-9_]+$" },
    "problem_ref": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "uses": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^algo:[a-z0-9_]+$" } },
    "verified": { "type": "boolean" },
    "test_cases_passed": { "type": "integer", "minimum": 0 },
    "test_cases_total": { "type": "integer", "minimum": 1 },
    "runtime_target": { "type": "string" },
    "effects": { "type": "array", "items": { "type": "string" } },
    "version": { "type": "string" },
    "candidate": { "const": true },
    "serves_truth": { "const": false }
  }
}
