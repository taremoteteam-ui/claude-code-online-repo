{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/variation_overlay.schema.json",
  "title": "VariationOverlay",
  "description": "A variation overlay that specializes base primitives/templates (industry, schema, region, role, compliance, runtime, data format). Overlays are stored; resolved combinations are materialized only on demand. Generated by scripts/build_place_discovery_geospatial_pack.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "overlay_id",
    "overlay_type",
    "title",
    "applies_to_lanes",
    "adds_concerns",
    "proof_additions",
    "ranking_bias",
    "notes",
    "version",
    "candidate",
    "serves_truth"
  ],
  "properties": {
    "record_type": { "const": "place_discovery_variation_overlay" },
    "overlay_id": { "type": "string", "pattern": "^overlay:[a-z0-9_]+\\.[a-z0-9_]+$" },
    "overlay_type": {
      "enum": ["industry", "schema", "region", "role", "compliance", "runtime", "data_format"]
    },
    "title": { "type": "string", "minLength": 3 },
    "applies_to_lanes": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "adds_concerns": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "proof_additions": { "type": "array", "items": { "type": "string" } },
    "ranking_bias": { "type": "string", "minLength": 10 },
    "notes": { "type": "string" },
    "version": { "type": "string" },
    "candidate": { "const": true },
    "serves_truth": { "const": false }
  }
}
