{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/primitive_card.schema.json",
  "title": "PrimitiveCard",
  "description": "A primitive candidate card: compact contract only (visible input edge, visible output edge, black-box behavior, effects, proof status). Implementation detail stays behind drill-down. Generated by scripts/build_place_discovery_geospatial_pack.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "primitive_id",
    "kind",
    "title",
    "lane",
    "p0_build_order",
    "input_edge",
    "output_edge",
    "blackbox",
    "effects",
    "runtime_targets",
    "proof_requirements",
    "known_failure_modes",
    "telemetry_signals",
    "source_surface_refs",
    "risk_class",
    "human_review_required",
    "version",
    "candidate",
    "serves_truth"
  ],
  "properties": {
    "record_type": { "const": "place_discovery_primitive_card" },
    "primitive_id": { "type": "string", "pattern": "^prim:place_discovery\\.[a-z0-9_]+$" },
    "kind": {
      "enum": [
        "registry.service",
        "source.adapter",
        "py.fn",
        "api.wrapper",
        "sql.query",
        "spatial.worker",
        "monitor.worker",
        "artifact.generator",
        "policy.gate",
        "resolver.worker"
      ]
    },
    "title": { "type": "string", "minLength": 3 },
    "lane": {
      "enum": [
        "health_facilities",
        "workforce_training",
        "open_maps",
        "open_data_portals",
        "geospatial_analysis_tooling"
      ]
    },
    "p0_build_order": { "type": ["integer", "null"], "minimum": 1, "maximum": 18 },
    "input_edge": { "type": "string", "pattern": "^[A-Za-z0-9+]+$" },
    "output_edge": { "type": "string", "pattern": "^[A-Za-z0-9+]+$" },
    "blackbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["does"],
      "properties": { "does": { "type": "string", "minLength": 20 } }
    },
    "effects": {
      "type": "array",
      "items": {
        "enum": [
          "none",
          "network_read",
          "network_write",
          "file_read",
          "file_write",
          "database_read",
          "database_write",
          "artifact_write",
          "model_call",
          "human_review"
        ]
      },
      "minItems": 1
    },
    "runtime_targets": {
      "type": "array",
      "items": {
        "enum": [
          "local.python",
          "container",
          "api.endpoint",
          "queue.worker",
          "sql.duckdb",
          "sql.postgis",
          "sql.bigquery",
          "browser.playwright",
          "kubernetes.job",
          "mcp.tool"
        ]
      },
      "minItems": 1
    },
    "proof_requirements": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "known_failure_modes": { "type": "array", "items": { "type": "string" }, "minItems": 2 },
    "telemetry_signals": { "type": "array", "items": { "type": "string" }, "minItems": 2 },
    "source_surface_refs": {
      "type": "array",
      "items": { "type": "string", "pattern": "^src:[a-z0-9_]+\\.[a-z0-9_]+$" }
    },
    "risk_class": { "enum": ["low", "medium", "high"] },
    "human_review_required": { "type": "boolean" },
    "version": { "type": "string" },
    "candidate": { "const": true },
    "serves_truth": { "const": false }
  }
}
