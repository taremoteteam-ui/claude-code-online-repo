{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/algorithmic_primitive_card.schema.json",
  "title": "AlgorithmicPrimitiveCard",
  "description": "A reusable algorithm/data-structure kernel that coding-problem solutions are decomposed into. Backed by a WORKING implementation in primitives/algorithmic_primitives.py; self_test_passes records that the kernel's fixture actually ran green at build time. Generated by scripts/build_coding_primitive_pack.py - never hand-edited.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type", "primitive_id", "title", "does", "pattern",
    "input_edge", "output_edge", "effects", "self_test_passes",
    "version", "candidate", "serves_truth"
  ],
  "properties": {
    "record_type": { "const": "algorithmic_primitive_card" },
    "primitive_id": { "type": "string", "pattern": "^algo:[a-z0-9_]+$" },
    "title": { "type": "string", "minLength": 1 },
    "does": { "type": "string", "minLength": 1 },
    "pattern": { "type": "string", "minLength": 1 },
    "input_edge": { "type": "string", "minLength": 1 },
    "output_edge": { "type": "string", "minLength": 1 },
    "effects": { "type": "array", "items": { "type": "string" } },
    "self_test_passes": { "type": "boolean" },
    "reuse_count": { "type": "integer", "minimum": 0 },
    "version": { "type": "string" },
    "candidate": { "const": true },
    "serves_truth": { "const": false }
  }
}
