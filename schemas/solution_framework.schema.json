{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/solution_framework.schema.json",
  "title": "SolutionFramework",
  "description": "A reusable, typed wiring scaffold for a class of problem: a named input->output contract plus ordered SLOTS (each a role that must be filled by a primitive producing a given canonical type). A framework is filled by binding each slot to a concrete producer in the capability graph; any ordering strategy can fill it, and the deterministic validator gates the result. Generated by scripts/build_solution_frameworks_pack.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "framework_id",
    "problem",
    "input_edge",
    "output_edge",
    "slots",
    "fill_strategies",
    "version",
    "candidate",
    "serves_truth"
  ],
  "properties": {
    "record_type": { "const": "solution_framework" },
    "framework_id": { "type": "string", "pattern": "^framework:[a-z0-9_.]+$" },
    "problem": { "type": "string", "minLength": 15 },
    "input_edge": { "type": "string", "pattern": "^[A-Za-z0-9+]+$" },
    "output_edge": { "type": "string", "pattern": "^[A-Za-z0-9+]+$" },
    "slots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "produces_type"],
        "properties": {
          "role": { "type": "string", "minLength": 2 },
          "produces_type": { "type": "string", "pattern": "^[A-Za-z0-9]+$" },
          "note": { "type": "string" }
        }
      }
    },
    "fill_strategies": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["deterministic_compile", "framework_fill", "llm_propose"] }
    },
    "version": { "type": "string" },
    "candidate": { "const": true },
    "serves_truth": { "const": false }
  }
}
