{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/mined_primitive.schema.json",
  "title": "MinedPrimitive",
  "description": "A candidate primitive FORMED by the ingestion pipeline from a source (a mined/scraped library signature, an API/MCP spec, ...). It carries the edge-typed contract needed to enter the capability graph, the source ref, a license status, and a verification status. It becomes source-backed only when a live source ref + receipts attach; here every row is fixture-derived and candidate=true / serves_truth=false. Generated by scripts/build_foundry_pack.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "mined_primitive_id",
    "source_id",
    "library",
    "symbol",
    "input_edge",
    "output_edge",
    "blackbox",
    "effects",
    "proof_obligations",
    "license",
    "retrieved_mode",
    "verification_status",
    "source_ref",
    "version",
    "candidate",
    "serves_truth"
  ],
  "properties": {
    "record_type": { "const": "mined_primitive" },
    "mined_primitive_id": { "type": "string", "pattern": "^mined:[a-z0-9_.]+$" },
    "source_id": { "type": "string", "pattern": "^src:[a-z0-9_.]+$" },
    "library": { "type": "string", "minLength": 2 },
    "symbol": { "type": "string", "minLength": 1 },
    "title": { "type": "string" },
    "input_edge": { "type": "string", "pattern": "^[A-Za-z0-9+]+$" },
    "output_edge": { "type": "string", "pattern": "^[A-Za-z0-9+]+$" },
    "blackbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["does"],
      "properties": { "does": { "type": "string", "minLength": 15 } }
    },
    "effects": {
      "type": "array",
      "items": {
        "enum": ["none", "file_read", "file_write", "network_read", "network_write",
                 "database_read", "database_write", "artifact_write", "secret_read",
                 "model_call", "human_review"]
      },
      "minItems": 1
    },
    "proof_obligations": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "license": { "type": "string" },
    "retrieved_mode": { "enum": ["fixture_synthetic", "live_network"] },
    "verification_status": { "enum": ["unverified", "fixture_verified", "license_blocked"] },
    "promotion_blockers": { "type": "array", "items": { "type": "string" } },
    "source_ref": { "type": "string", "minLength": 3 },
    "version": { "type": "string" },
    "candidate": { "const": true },
    "serves_truth": { "const": false }
  }
}
