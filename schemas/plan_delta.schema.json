{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/plan_delta.schema.json",
  "title": "PlanDelta",
  "description": "A proposed route over a candidate bundle: ordered primitive steps with reasons. A delta is a proposal, never truth (is_truth is const false) - it becomes executable only when compiled into a PlanLock.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "delta_id",
    "bundle_ref",
    "proposed_route",
    "is_truth",
    "proposed_by",
    "version",
    "candidate",
    "serves_truth"
  ],
  "properties": {
    "record_type": { "const": "plan_delta" },
    "delta_id": { "type": "string", "pattern": "^delta:[a-z0-9_.]+$" },
    "bundle_ref": { "type": "string", "pattern": "^bundle:[a-z0-9_.]+$" },
    "proposed_route": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step", "primitive_id", "reason"],
        "properties": {
          "step": { "type": "integer", "minimum": 1 },
          "primitive_id": { "type": "string", "pattern": "^prim:[a-z0-9_.]+$" },
          "reason": { "type": "string", "minLength": 10 }
        }
      }
    },
    "is_truth": { "const": false },
    "proposed_by": { "type": "string", "minLength": 3 },
    "version": { "type": "string" },
    "candidate": { "const": true },
    "serves_truth": { "const": false }
  }
}
