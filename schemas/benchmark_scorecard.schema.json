{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/benchmark_scorecard.schema.json",
  "title": "BenchmarkScorecard",
  "description": "A measured scorecard for one benchmark task demand executed by one arm. Only arms that actually ran get scorecards; unrun arms are absent, never estimated. All values are computed by the harness.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "scorecard_id",
    "task_id",
    "task_family",
    "arm_id",
    "run_id",
    "measured",
    "execution_mode",
    "task_success",
    "wall_clock_seconds",
    "depth_to_solution",
    "runtime_llm_tokens",
    "primitives_executed",
    "primitive_reuse_count",
    "proof_coverage",
    "receipt_ids",
    "artifacts_emitted",
    "plan_lock_id",
    "route_hash",
    "replay_verified",
    "notes",
    "candidate",
    "serves_truth"
  ],
  "properties": {
    "record_type": { "const": "place_discovery_benchmark_scorecard" },
    "scorecard_id": { "type": "string", "pattern": "^score:[0-9a-f]{16}$" },
    "task_id": { "type": "string", "pattern": "^bench:place_discovery\\.[a-z0-9_]+\\.[0-9]{4}$" },
    "task_family": { "type": "string" },
    "arm_id": { "enum": ["A1", "A2", "A3", "A4", "A5"] },
    "run_id": { "type": "string", "minLength": 4 },
    "measured": { "const": true },
    "execution_mode": { "enum": ["fixture_offline", "live_network", "pure_local"] },
    "task_success": { "type": "boolean" },
    "wall_clock_seconds": { "type": "number", "minimum": 0 },
    "depth_to_solution": { "enum": ["L1", "L2", "L3", "L4", "L5", "L6", "L7"] },
    "runtime_llm_tokens": { "type": "integer", "minimum": 0 },
    "primitives_executed": {
      "type": "array",
      "items": { "type": "string", "pattern": "^prim:place_discovery\\.[a-z0-9_]+$" },
      "minItems": 1
    },
    "primitive_reuse_count": { "type": "integer", "minimum": 0 },
    "proof_coverage": { "type": "number", "minimum": 0, "maximum": 1 },
    "receipt_ids": { "type": "array", "items": { "type": "string" } },
    "artifacts_emitted": { "type": "array", "items": { "type": "string" } },
    "plan_lock_id": { "type": "string", "pattern": "^lock:[a-z0-9_.]+$" },
    "route_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "replay_verified": { "type": "boolean" },
    "notes": { "type": "string" },
    "candidate": { "const": true },
    "serves_truth": { "const": false }
  }
}
