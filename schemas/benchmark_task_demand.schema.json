{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/benchmark_task_demand.schema.json",
  "title": "BenchmarkTaskDemand",
  "description": "A generated benchmark task demand for the place-discovery-geospatial lane. Task demands are candidate benchmark material; no task here has been run, and no scorecard value exists until produced by a local harness with receipts. Generated by scripts/build_place_discovery_geospatial_pack.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "task_id",
    "task_family",
    "title",
    "area_of_interest",
    "directed_question",
    "source_policy",
    "expected_artifacts",
    "primitive_demands",
    "comparison_arms",
    "scorecard_fields",
    "depth_ladder",
    "difficulty",
    "version",
    "candidate",
    "serves_truth"
  ],
  "properties": {
    "record_type": { "const": "place_discovery_benchmark_task_demand" },
    "task_id": {
      "type": "string",
      "pattern": "^bench:place_discovery\\.[a-z0-9_]+\\.[0-9]{4}$"
    },
    "task_family": {
      "enum": [
        "clinic_discovery",
        "training_provider_discovery",
        "care_desert_analysis",
        "portal_dataset_harvest",
        "osm_poi_extraction",
        "schema_drift_detection",
        "site_selection_ranking",
        "map_dashboard_generation"
      ]
    },
    "title": { "type": "string", "minLength": 3 },
    "area_of_interest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aoi_id", "name", "aoi_type", "state", "context_tags"],
      "properties": {
        "aoi_id": { "type": "string", "pattern": "^aoi:[a-z0-9_]+$" },
        "name": { "type": "string" },
        "aoi_type": { "enum": ["county", "metro", "city", "state", "census_region"] },
        "state": { "type": "string" },
        "context_tags": { "type": "array", "items": { "type": "string" } }
      }
    },
    "directed_question": { "type": "string", "minLength": 20 },
    "source_policy": {
      "enum": ["official_first", "open_first", "official_and_open_compare", "portal_catalog_only"]
    },
    "expected_artifacts": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "primitive_demands": {
      "type": "array",
      "items": { "type": "string", "pattern": "^prim:place_discovery\\.[a-z0-9_]+$" },
      "minItems": 1
    },
    "comparison_arms": {
      "type": "array",
      "items": { "enum": ["A1", "A2", "A3", "A4", "A5"] },
      "minItems": 2
    },
    "scorecard_fields": { "type": "array", "items": { "type": "string" }, "minItems": 3 },
    "depth_ladder": {
      "type": "array",
      "items": { "enum": ["L1", "L2", "L3", "L4", "L5", "L6", "L7"] },
      "minItems": 7,
      "maxItems": 7
    },
    "difficulty": { "enum": ["easy", "medium", "hard"] },
    "version": { "type": "string" },
    "candidate": { "const": true },
    "serves_truth": { "const": false }
  }
}
