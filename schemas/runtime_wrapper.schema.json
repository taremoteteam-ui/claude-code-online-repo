{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/runtime_wrapper.schema.json",
  "title": "RuntimeWrapper",
  "description": "A runtime wrapper overlay: lowers a core capability edge into a concrete execution shape (function, endpoint, MCP tool, worker, job, ...) adding its own policy edge, effects, and proof obligations. Generated by scripts/build_universal_primitive_pack.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "wrapper_id",
    "title",
    "runtime_target",
    "input_policy_edge",
    "output_receipt_edge",
    "added_effects",
    "added_proof_requirements",
    "description",
    "version",
    "candidate",
    "serves_truth"
  ],
  "properties": {
    "record_type": { "const": "runtime_wrapper" },
    "wrapper_id": { "type": "string", "pattern": "^wrap:[a-z0-9_]+$" },
    "title": { "type": "string", "minLength": 3 },
    "runtime_target": {
      "enum": ["local.python", "api.endpoint", "mcp.tool", "queue.worker",
               "cron.job", "serverless.function", "kubernetes.job",
               "cli.command", "ci.action", "browser.worker"]
    },
    "input_policy_edge": { "type": "string", "pattern": "^[A-Za-z0-9+]*$" },
    "output_receipt_edge": { "type": "string", "pattern": "^[A-Za-z0-9+]+$" },
    "added_effects": {
      "type": "array",
      "items": {
        "enum": ["none", "file_read", "file_write", "network_read",
                 "network_write", "network_bind", "database_read",
                 "database_write", "artifact_write", "secret_read"]
      }
    },
    "added_proof_requirements": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "description": { "type": "string", "minLength": 15 },
    "version": { "type": "string" },
    "candidate": { "const": true },
    "serves_truth": { "const": false }
  }
}
