{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/pipeline_wave_template.schema.json",
  "title": "PipelineWaveTemplate",
  "description": "A multi-wave pipeline: an ordered sequence of WAVES, each a SET of primitive families that run together (parallelizable within a wave) before the next wave. Models dbt layering (staging -> intermediate -> marts), the medallion architecture (bronze -> silver -> gold), and warehouse builds (dims -> facts -> marts). Wave N's inputs must be produced by wave <N or declared as pipeline inputs - the same typed-edge topological-layer contract the edge compiler enforces. Generated by scripts/build_warehouse_analytics_pack.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "pipeline_id",
    "title",
    "pattern",
    "description",
    "pipeline_inputs",
    "pipeline_outputs",
    "waves",
    "invariants",
    "proof_requirements",
    "known_failure_modes",
    "version",
    "candidate",
    "serves_truth"
  ],
  "properties": {
    "record_type": { "const": "pipeline_wave_template" },
    "pipeline_id": { "type": "string", "pattern": "^pipeline:[a-z0-9_]+\\.[a-z0-9_]+$" },
    "title": { "type": "string", "minLength": 3 },
    "pattern": {
      "enum": ["medallion", "dbt_layered", "star_build", "lakehouse_elt",
               "wide_table_refresh", "cdc_to_scd2", "analytics_mart",
               "semantic_layer_build", "snowflake_normalize", "one_big_table"]
    },
    "description": { "type": "string", "minLength": 20 },
    "pipeline_inputs": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "pipeline_outputs": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "waves": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["wave_index", "wave_name", "member_family_refs",
                     "parallelizable", "consumes", "produces"],
        "properties": {
          "wave_index": { "type": "integer", "minimum": 1 },
          "wave_name": { "type": "string", "minLength": 2 },
          "member_family_refs": {
            "type": "array",
            "items": { "type": "string", "pattern": "^prim:[a-z0-9_]+\\.[a-z0-9_]+$" },
            "minItems": 1
          },
          "parallelizable": { "type": "boolean" },
          "consumes": { "type": "array", "items": { "type": "string" } },
          "produces": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
        }
      }
    },
    "invariants": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "proof_requirements": { "type": "array", "items": { "type": "string" }, "minItems": 2 },
    "known_failure_modes": { "type": "array", "items": { "type": "string" }, "minItems": 2 },
    "version": { "type": "string" },
    "candidate": { "const": true },
    "serves_truth": { "const": false }
  }
}
