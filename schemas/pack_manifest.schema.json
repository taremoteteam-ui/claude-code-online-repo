{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/pack_manifest.schema.json",
  "title": "PackManifest",
  "description": "Manifest for a generated knowledge pack. All counts and hashes are computed by the builder, never typed by hand. The manifest is the only place counts may be read from.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pack_id",
    "pack_version",
    "generated_by",
    "schema_refs",
    "files",
    "row_counts",
    "total_rows",
    "candidate",
    "serves_truth"
  ],
  "properties": {
    "pack_id": { "type": "string" },
    "pack_version": { "type": "string" },
    "generated_by": { "type": "string" },
    "schema_refs": { "type": "array", "items": { "type": "string" } },
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rows", "content_sha256"],
        "properties": {
          "rows": { "type": "integer", "minimum": 0 },
          "content_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "row_counts": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "total_rows": { "type": "integer", "minimum": 0 },
    "candidate": { "const": true },
    "serves_truth": { "const": false }
  }
}
