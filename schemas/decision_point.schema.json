{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/decision_point.schema.json",
  "title": "DecisionPoint",
  "description": "A single, stable, globally-unique decision in the codebase (runtime or development). It owns a portfolio of contract-substitutable ExecutionPaths, a selection policy over receipts, a cold-start default, and a reversibility regime. The whole point: store the SPACE of paths as data; keep SELECTION as a policy over receipts, so adding a path or changing how you choose is a data edit, not a rewrite. Generated by scripts/build_decision_portfolio_pack.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "decision_id",
    "title",
    "question",
    "regime",
    "context_signature",
    "contract",
    "selection_policy",
    "default_path",
    "version",
    "candidate",
    "serves_truth"
  ],
  "properties": {
    "record_type": { "const": "decision_point" },
    "decision_id": { "type": "string", "pattern": "^decision:[a-z0-9_.]+$" },
    "title": { "type": "string", "minLength": 3 },
    "question": { "type": "string", "minLength": 15 },
    "regime": { "enum": ["runtime", "development"] },
    "context_signature": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "output", "win_definition", "consumes", "produces"],
      "properties": {
        "input": { "type": "string", "minLength": 3 },
        "output": { "type": "string", "minLength": 3 },
        "win_definition": { "type": "string", "minLength": 10 },
        "consumes": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "description": "state keys this fork requires from the initial state or an upstream fork's produces"
        },
        "produces": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "minItems": 1,
          "description": "state keys this fork yields (the edge downstream forks consume)"
        }
      }
    },
    "selection_policy": {
      "enum": ["deterministic_tier", "cheapest_that_proves", "argmax_receipts", "epsilon_greedy"]
    },
    "epsilon": { "type": "number", "minimum": 0, "maximum": 1 },
    "default_path": { "type": "string", "pattern": "^path:[a-z0-9_.]+$" },
    "execute_all_when_cheap": { "type": "boolean" },
    "version": { "type": "string" },
    "candidate": { "const": true },
    "serves_truth": { "const": false }
  }
}
