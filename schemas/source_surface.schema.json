{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/source_surface.schema.json",
  "title": "SourceSurface",
  "description": "A source surface record for the place-discovery-geospatial lane. Generated by scripts/build_place_discovery_geospatial_pack.py; never hand-edit emitted rows.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "source_id",
    "title",
    "lane",
    "surface_type",
    "provider",
    "base_url_family",
    "machine_readable",
    "auth",
    "license_family",
    "attribution_required",
    "usage_policy_notes",
    "freshness_class",
    "data_domains",
    "adapter_priority",
    "compliance_gates",
    "official_source",
    "source_refs",
    "version",
    "candidate",
    "serves_truth"
  ],
  "properties": {
    "record_type": { "const": "place_discovery_source_surface" },
    "source_id": { "type": "string", "pattern": "^src:[a-z0-9_]+\\.[a-z0-9_]+$" },
    "title": { "type": "string", "minLength": 3 },
    "lane": {
      "enum": [
        "health_facilities",
        "workforce_training",
        "open_maps",
        "open_data_portals",
        "geospatial_analysis_tooling"
      ]
    },
    "surface_type": {
      "enum": [
        "bulk_download",
        "rest_api",
        "catalog_api",
        "tile_or_feature_service",
        "geocoding_service",
        "routing_engine",
        "library",
        "registry",
        "portal_family"
      ]
    },
    "provider": { "type": "string", "minLength": 2 },
    "base_url_family": { "type": "string", "pattern": "^https?://" },
    "machine_readable": { "type": "boolean" },
    "auth": { "enum": ["none", "api_key", "oauth", "varies"] },
    "license_family": {
      "enum": [
        "public_domain_us_gov",
        "odbl",
        "cc_by",
        "cc0",
        "cc_by_sa",
        "mixed",
        "terms_gated",
        "open_source_license"
      ]
    },
    "attribution_required": { "type": "boolean" },
    "usage_policy_notes": { "type": "string", "minLength": 10 },
    "freshness_class": {
      "enum": ["daily", "weekly", "monthly", "quarterly", "annual", "rolling", "varies", "static"]
    },
    "data_domains": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "adapter_priority": { "enum": ["P0", "P1", "P2"] },
    "compliance_gates": { "type": "array", "items": { "type": "string" } },
    "official_source": { "type": "boolean" },
    "source_refs": {
      "type": "array",
      "items": { "type": "string", "pattern": "^https?://" },
      "minItems": 1
    },
    "version": { "type": "string" },
    "candidate": { "const": true },
    "serves_truth": { "const": false }
  }
}
