{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/document_extraction_primitive.schema.json",
  "title": "DocumentExtractionPrimitive",
  "description": "Compact contract for a working document-extraction primitive (the deterministic workers that ingest, segment, extract-with-spans, normalize, verify, and bundle). Every extraction primitive that emits field values must require source_span_verification. Generated by scripts/build_document_extraction_pack.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "primitive_id",
    "kind",
    "title",
    "input_edge",
    "output_edge",
    "blackbox",
    "effects",
    "runtime_targets",
    "proof_requirements",
    "known_failure_modes",
    "telemetry_signals",
    "risk_class",
    "human_review_required",
    "version",
    "candidate",
    "serves_truth"
  ],
  "properties": {
    "record_type": { "const": "document_extraction_primitive" },
    "primitive_id": { "type": "string", "pattern": "^prim:document_extraction\\.[a-z0-9_]+$" },
    "kind": {
      "enum": [
        "py.fn",
        "ingest.worker",
        "segment.worker",
        "extract.worker",
        "normalize.worker",
        "verify.worker",
        "artifact.generator",
        "policy.gate"
      ]
    },
    "title": { "type": "string", "minLength": 3 },
    "input_edge": { "type": "string", "pattern": "^[A-Za-z0-9+]+$" },
    "output_edge": { "type": "string", "pattern": "^[A-Za-z0-9+]+$" },
    "blackbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["does"],
      "properties": { "does": { "type": "string", "minLength": 20 } }
    },
    "effects": {
      "type": "array",
      "items": {
        "enum": ["none", "file_read", "file_write", "artifact_write", "model_call", "human_review"]
      },
      "minItems": 1
    },
    "runtime_targets": {
      "type": "array",
      "items": {
        "enum": ["local.python", "container", "api.endpoint", "queue.worker", "mcp.tool"]
      },
      "minItems": 1
    },
    "proof_requirements": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "known_failure_modes": { "type": "array", "items": { "type": "string" }, "minItems": 2 },
    "telemetry_signals": { "type": "array", "items": { "type": "string" }, "minItems": 2 },
    "risk_class": { "enum": ["low", "medium", "high"] },
    "human_review_required": { "type": "boolean" },
    "version": { "type": "string" },
    "candidate": { "const": true },
    "serves_truth": { "const": false }
  }
}
