{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/primitive_group.schema.json",
  "title": "PrimitiveGroup",
  "description": "A primitive group candidate: one visible edge hiding a repeated internal route. Member edges are drill-down detail, not model-boundary context. Generated by scripts/build_place_discovery_geospatial_pack.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "group_id",
    "title",
    "lane",
    "input_edge",
    "output_edge",
    "blackbox",
    "hidden_member_edges",
    "member_primitive_refs",
    "effects",
    "proof_requirements",
    "known_failure_modes",
    "risk_class",
    "human_review_required",
    "version",
    "candidate",
    "serves_truth"
  ],
  "properties": {
    "record_type": { "const": "place_discovery_primitive_group" },
    "group_id": { "type": "string", "pattern": "^grp:place_discovery\\.[a-z0-9_]+$" },
    "title": { "type": "string", "minLength": 3 },
    "lane": {
      "enum": [
        "health_facilities",
        "workforce_training",
        "open_maps",
        "open_data_portals",
        "geospatial_analysis_tooling"
      ]
    },
    "input_edge": { "type": "string", "pattern": "^[A-Za-z0-9+]+$" },
    "output_edge": { "type": "string", "pattern": "^[A-Za-z0-9+]+$" },
    "blackbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["does"],
      "properties": { "does": { "type": "string", "minLength": 20 } }
    },
    "hidden_member_edges": {
      "type": "array",
      "items": { "type": "string", "pattern": "->" },
      "minItems": 3
    },
    "member_primitive_refs": {
      "type": "array",
      "items": { "type": "string", "pattern": "^prim:place_discovery\\.[a-z0-9_]+$" },
      "minItems": 2
    },
    "effects": {
      "type": "array",
      "items": {
        "enum": [
          "none",
          "network_read",
          "network_write",
          "file_read",
          "file_write",
          "database_read",
          "database_write",
          "artifact_write",
          "model_call",
          "human_review"
        ]
      },
      "minItems": 1
    },
    "proof_requirements": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "known_failure_modes": { "type": "array", "items": { "type": "string" }, "minItems": 2 },
    "risk_class": { "enum": ["low", "medium", "high"] },
    "human_review_required": { "type": "boolean" },
    "version": { "type": "string" },
    "candidate": { "const": true },
    "serves_truth": { "const": false }
  }
}
