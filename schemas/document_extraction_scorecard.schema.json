{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/document_extraction_scorecard.schema.json",
  "title": "DocumentExtractionScorecard",
  "description": "A measured scorecard for one document-extraction benchmark document run by one arm. Only arms that actually ran get scorecards. Fixture-mode runs measure the extraction route on synthetic documents, not real-world accuracy. All values computed by the harness.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "scorecard_id",
    "document_family",
    "fixture_path",
    "arm_id",
    "run_id",
    "measured",
    "execution_mode",
    "task_success",
    "wall_clock_seconds",
    "depth_to_solution",
    "runtime_llm_tokens",
    "fields_expected",
    "fields_located",
    "field_recall",
    "source_span_coverage",
    "value_exact_match_ratio",
    "normalization_accuracy",
    "proof_coverage",
    "receipt_ids",
    "notes",
    "candidate",
    "serves_truth"
  ],
  "properties": {
    "record_type": { "const": "document_extraction_scorecard" },
    "scorecard_id": { "type": "string", "pattern": "^docscore:[0-9a-f]{16}$" },
    "document_family": {
      "enum": ["employment_agreement", "commercial_lease", "oil_gas_lease",
               "purchase_and_sale", "mutual_nda"]
    },
    "fixture_path": { "type": "string" },
    "arm_id": { "enum": ["A1", "A2", "A3", "A4", "A5"] },
    "run_id": { "type": "string", "minLength": 4 },
    "measured": { "const": true },
    "execution_mode": { "enum": ["fixture_offline", "live_document", "pure_local"] },
    "task_success": { "type": "boolean" },
    "wall_clock_seconds": { "type": "number", "minimum": 0 },
    "depth_to_solution": { "enum": ["L1", "L2", "L3", "L4", "L5", "L6", "L7"] },
    "runtime_llm_tokens": { "type": "integer", "minimum": 0 },
    "fields_expected": { "type": "integer", "minimum": 0 },
    "fields_located": { "type": "integer", "minimum": 0 },
    "field_recall": { "type": "number", "minimum": 0, "maximum": 1 },
    "source_span_coverage": { "type": "number", "minimum": 0, "maximum": 1 },
    "value_exact_match_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
    "normalization_accuracy": { "type": "number", "minimum": 0, "maximum": 1 },
    "proof_coverage": { "type": "number", "minimum": 0, "maximum": 1 },
    "receipt_ids": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": "string" },
    "candidate": { "const": true },
    "serves_truth": { "const": false }
  }
}
