{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/reusable_primitive_family.schema.json",
  "title": "ReusablePrimitiveFamily",
  "description": "A base reusable-primitive family: one recurring capability with a compact contract and a first-class problem-solution block. Families are crossed with their applicable runtime wrappers to materialize resolved primitives. Generated by scripts/build_universal_primitive_pack.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "family_id",
    "domain",
    "title",
    "input_edge",
    "output_edge",
    "blackbox",
    "effects",
    "base_runtime_targets",
    "applicable_runtime_wrappers",
    "applicable_data_formats",
    "proof_requirements",
    "problem_solution",
    "source_ref_families",
    "risk_class",
    "human_review_required",
    "version",
    "candidate",
    "serves_truth"
  ],
  "properties": {
    "record_type": { "const": "reusable_primitive_family" },
    "family_id": { "type": "string", "pattern": "^prim:[a-z0-9_]+\\.[a-z0-9_]+$" },
    "domain": {
      "enum": [
        "auth_identity", "security", "crud_data_app", "trackers",
        "data_engineering", "format_conversion", "data_quality",
        "integration_async", "api_surface", "messaging", "devops_deploy",
        "observability", "guardrails_safety", "entity_resolution",
        "enrichment_verification", "document_intelligence", "rag_retrieval",
        "geospatial", "similarity_indexing",
        "dbt_transform", "data_warehouse", "data_engineering_wh",
        "analytics_patterns", "semantic_layer", "multiset_ops",
        "media_processing", "image_processing", "computer_vision",
        "api_integration", "data_enrichment",
        "coding_agent", "competitive_programming", "algorithms"
      ]
    },
    "title": { "type": "string", "minLength": 3 },
    "input_edge": { "type": "string", "pattern": "^[A-Za-z0-9+]+$" },
    "output_edge": { "type": "string", "pattern": "^[A-Za-z0-9+]+$" },
    "blackbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["does"],
      "properties": { "does": { "type": "string", "minLength": 20 } }
    },
    "effects": {
      "type": "array",
      "items": {
        "enum": ["none", "file_read", "file_write", "network_read",
                 "network_write", "database_read", "database_write",
                 "artifact_write", "secret_read", "model_call", "human_review"]
      },
      "minItems": 1
    },
    "base_runtime_targets": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "applicable_runtime_wrappers": {
      "type": "array",
      "items": { "type": "string", "pattern": "^wrap:[a-z0-9_]+$" },
      "minItems": 1
    },
    "applicable_data_formats": { "type": "array", "items": { "type": "string" } },
    "proof_requirements": { "type": "array", "items": { "type": "string" }, "minItems": 2 },
    "problem_solution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["problem", "naive_agent_failure", "solution", "core_components",
                   "common_inputs", "common_outputs", "known_pitfalls", "success_signals"],
      "properties": {
        "problem": { "type": "string", "minLength": 20 },
        "naive_agent_failure": { "type": "string", "minLength": 15 },
        "solution": { "type": "string", "minLength": 15 },
        "core_components": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "common_inputs": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "common_outputs": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "known_pitfalls": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "success_signals": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      }
    },
    "source_ref_families": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "risk_class": { "enum": ["low", "medium", "high"] },
    "human_review_required": { "type": "boolean" },
    "version": { "type": "string" },
    "candidate": { "const": true },
    "serves_truth": { "const": false }
  }
}
